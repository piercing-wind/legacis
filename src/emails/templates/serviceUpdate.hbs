<!DOCTYPE html>
<html>

<head>
   <meta charset="UTF-8" />
   <title>{{title}}</title>
   <style>
    * { font-family: 'Lato', Helvetica, sans-serif !important; }
    p { font-size: 16px !important; }
   </style>
</head>

<body style="margin:0; border-radius:10px; background-color: #fef5ff; padding: 24px; font-family: Lato, 'Helvetica Neue', Arial, 'sans-serif';">

   <div style="max-width: 600px; width: 600px; margin: 0 auto; border-radius:10px; background-color: #ffffff; box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);">
      {{> header}}
      <div style="padding: 24px;">
         <h3>Hello {{name}},</h3>
         <p>
           We wanted to let you know that there has been an update to your <strong>{{serviceName}}</strong> subscription.
         </p>
         <p>
           Please log in to your account to view the latest changes and details regarding your stocks.
         </p>
         <a href="{{dashboardUrl}}"
            style="display: inline-block; font-size :larger; background-color: #3529a7; color: white; padding: 12px 24px; text-decoration: none; border-radius: 8px; font-weight: bold;">
            Dashboard
         </a>
      </div>
      {{> footer}}
   </div>
</body>

</html>