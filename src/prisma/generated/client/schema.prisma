// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  INDIVIDUAL
  BUSINESS
}

enum UserRole {
  USER
  ADMIN
}

enum Status {
  CLOSED_CALL
  ACTIVE_CALL
}

enum ServiceType {
  COMBO
  RESEARCH_ADVISORY //Momentum SME VALUE etc
  RESEARCH_ADVISORY_MODEL_PORTFOLIO //alpha mircos
  RESEARCH_ADVISORY_MUTUAL_FUNDS
  PORTFOLIO_REVIEW
  SMALLCASE
  PLATINA_WEALTH
}

enum VerificationType {
  EMAIL_UPDATE
  PHONE_UPDATE
  EMAIL_VERIFY
  PHONE_VERIFY
  RESET_PASS_VERIFY
  CONSENT
  AGREEMENT_ACCEPTANCE
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  phone         String?   @unique
  username      String?   @unique
  image         String?
  password      String?
  dob           String?
  pan           String?   @unique
  aadharNumber  String?
  gstin         String?
  address       String?
  state         String?
  city          String?
  zip           String?
  panVerified   DateTime?
  termsAccepted DateTime?
  emailVerified DateTime?
  phoneVerified DateTime?
  isBanned      Boolean   @default(false)

  userType               UserType                    @default(INDIVIDUAL)
  role                   UserRole                    @default(USER)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  accounts               Account[]
  purchasedServices      UserPurchasedServices[]
  panVerificationData    panVerificationData?
  transaction            Transaction[]
  riskProfile            UserRiskProfile?
  riskProfileResponses   UserRiskProfileResponse[]
  platinaRecommendations UserPlatinaRecommendation[]
  blogs                  Blog[] // only for admin
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Otp {
  id               String           @id @default(uuid())
  userId           String
  identifier       String
  otp              String
  expires_at       DateTime
  verificationType VerificationType
  createdAt        DateTime         @default(now())

  @@unique([userId, identifier, verificationType])
  @@index([userId, identifier])
}

model panVerificationData {
  userId    String   @id
  provider  String
  result    Json
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GrantType {
  PURCHASED // User actually paid for it
  COMPLIMENTARY // Granted as part of another service purchase
  ADMIN_GRANTED // Manually granted by admin
}

model UserPurchasedServices {
  id                  String    @id @default(uuid())
  userId              String
  serviceId           String
  purchaseDate        DateTime  @default(now())
  expiryDate          DateTime? //nullable
  servicePlanId       String?
  agreementAcceptedAt DateTime?
  agreementData       Json?

  grantType       GrantType @default(PURCHASED)
  grantedBy       String? // Admin user ID if manually granted
  grantReason     String? // Reason for manual grant or promotion details
  parentServiceId String? // If complimentary, which service purchase triggered this
  transactionId   String? // Link to actual payment transaction
  isActive        Boolean   @default(true)

  grantMetadata   Json? //For coupons 
  portfolioReview PortfolioReview?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  servicePlan ServicePlan? @relation(fields: [servicePlanId], references: [id])

  @@unique([userId, serviceId, expiryDate])
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  percentOff  Float
  expiryDate  DateTime

  serviceId     String?
  servicePlanId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service      Service?      @relation(fields: [serviceId], references: [id])
  servicePlan  ServicePlan?  @relation(fields: [servicePlanId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id              String   @id @default(uuid())
  orderId         String?  @unique
  paymentId       String?
  couponId        String?
  userId          String
  serviceId       String
  amount          Float
  servicePlanId   String?
  currency        String   @default("INR")
  status          String
  paymentGateway  String
  idempotencyKey  String?
  webhookResponse Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  extraData       Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  servicePlan ServicePlan? @relation(fields: [servicePlanId], references: [id])
  coupon      Coupon?      @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([orderId])
}

enum AgreementType {
  AGREEMENT
  POLICY
}

enum PolicyType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  REFUND_POLICY
  COOKIE_POLICY
  DISCLOSURE_RA
  DISCLOSURE_IA
  GRIEVANCE_REDRESSAL
  INVESTOR_CHARTER
}

model Agreement {
  id              String        @id @default(uuid())
  name            String
  content         String
  version         Int
  hash            String
  type            AgreementType @default(AGREEMENT)
  policyType      PolicyType?
  signatoryPerson String?
  companyName     String?
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())

  serviceAgreements ServiceAgreement[]
}

model ServiceAgreement {
  id          String @id @default(uuid())
  serviceId   String
  agreementId String

  service   Service   @relation(fields: [serviceId], references: [id])
  agreement Agreement @relation(fields: [agreementId], references: [id])
}

model ComplimentaryService {
  id                     String @id @default(uuid())
  serviceId              String // The main service being sold
  complimentaryServiceId String // The included complimentary service

  complimentaryServicePlanId String? // Which plan of the complimentary service to grant

  service              Service      @relation("Complimentary", fields: [serviceId], references: [id], onDelete: Cascade)
  complimentaryService Service      @relation("ComplimentaryIncluded", fields: [complimentaryServiceId], references: [id], onDelete: Cascade)
  complimentaryPlan    ServicePlan? @relation(fields: [complimentaryServicePlanId], references: [id])

  @@unique([serviceId, complimentaryServiceId])
  @@index([serviceId])
  @@index([complimentaryServiceId])
}

model ServicePlan {
  id             String @id @default(uuid())
  serviceId      String
  label          String // "Monthly", "Quarterly", etc.
  durationInDays Int // 30, 90, 180

  price    Float
  discount Float? // Optional: stored as 0.1 (10%)
  isActive Boolean @default(true)

  stockLimit Int?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  userPurchasedServices UserPurchasedServices[]
  transactions          Transaction[]
  complimentaryServices ComplimentaryService[]
  coupon                Coupon[]
}

model Service {
  id              String  @id @default(uuid())
  name            String
  slug            String  @unique
  order           Int     @default(1)
  tag             String?
  label           String?
  serviceClass    String?
  description     String?
  chart           Json?
  comparisonTitle String?
  philosophy      Json?

  recommendedService                      String[]
  taxPercent                              Float?
  plans                                   ServicePlan[]
  features                                Json?
  faq                                     Json?
  raResearchReport                        Json? //For Research Advisory Services
  active                                  Boolean                                   @default(true)
  type                                    ServiceType
  createdAt                               DateTime                                  @default(now())
  updatedAt                               DateTime                                  @updatedAt
  researchAdvisoryStockList               ResearchAdvisoryStockList[]
  researchAdvisoryModelPortfolioStockList ResearchAdvisoryModelPortfolioStockList[]
  researchAdvisoryMutualFundStockList     ResearchAdvisoryMutualFundStockList[]
  servicePlatinaWealth                    ServicePlatinaWealth?

  complimentaryService    ComplimentaryService[] @relation("Complimentary") //Use this when you want to find all complimentary services included with a main service.
  complimentaryIncludedIn ComplimentaryService[] @relation("ComplimentaryIncluded") //Use this when you want to find all main services where a service is included as complimentary.

  afterPurchaseFeaturesDelta Json?
  detailMutualFundPageDelta  Json?
  agreements                 ServiceAgreement[]
  purchasedServices          UserPurchasedServices[]
  Transaction                Transaction[]
  coupon                     Coupon[]
}

enum PortfolioReviewStatus {
  PENDING_UPLOAD
  UNDER_REVIEW
  COMPLETED
  EXPIRED
}

model PortfolioReview {
  id                     String                @id @default(uuid())
  userPurchasedServiceId String                @unique
  status                 PortfolioReviewStatus @default(PENDING_UPLOAD)

  userId           String
  uploadedFileName String?
  uploadedFileUrl  String?
  stockCount       Int?

  reviewedFileName String?
  reviewedFileUrl  String?
  reviewedBy       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userPurchasedService UserPurchasedServices @relation(fields: [userPurchasedServiceId], references: [id], onDelete: Cascade)
}

enum ResearchAdvisoryStockStatus {
  OPEN
  CLOSED
}

enum CallType {
  BUY
  SELL
}

model ResearchAdvisoryStockList {
  id          String                      @id @default(uuid())
  serviceId   String
  name        String
  stockTicker String
  sector      String?
  status      ResearchAdvisoryStockStatus
  callType    CallType
  entryPrice  Float?
  targetPrice Float?
  stopLoss    Float?
  exitPrice   Float?

  rationale     Json? // Fomat { "text" : "value"}
  exitRationale Json?
  exitDate      DateTime?
  entryDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ResearchAdvisoryModelPortfolioStockList {
  id              String  @id @default(uuid())
  serviceId       String
  name            String
  stockTicker     String
  sector          String
  portfolioWeight Float
  researchReport  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ResearchAdvisoryMutualFundStockList {
  id        String @id @default(uuid())
  serviceId String
  name      String
  category  String
  weight    Float
  rationale Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

enum QuestionType {
  MCQ
  SCALE
  YES_NO
  TEXT
}

enum QuestionCategory {
  NORMAL
  PLATINA_WEALTH
}

/// - For MCQ and YES_NO, `options` is an array of objects:
///   [{ "value": 1, "text": "Low risk", "weight": 1 }]
///   For YES_NO, example:
///   [{ "value": "yes", "text": "Yes", "weight": 5 }, { "value": "no", "text": "No", "score": 0 }]
/// - For SCALE, use `minScore` and `maxScore` for the range; `options` is usually null.
/// - For TEXT, `options` is null and `weight` is usually 0 or not used.

model RiskProfileQuestion {
  id        String           @id @default(uuid())
  question  String // The question text
  type      QuestionType
  options   Json?
  isActive  Boolean          @default(true)
  order     Int // Display order
  category  QuestionCategory @default(NORMAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  userResponses UserRiskProfileResponse[]
}

model UserRiskProfileResponse {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  answer     Json // Store the selected answer(s)
  score      Int // Score for this answer
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question RiskProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

enum RiskLevel {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

model UserRiskProfile {
  id                    String     @id @default(uuid())
  userId                String     @unique
  totalScore            Int // Sum of all question scores
  riskLevel             RiskLevel?
  riskPercentage        Float // Risk score as percentage
  completedAt           DateTime   @default(now())
  lastUpdated           DateTime   @updatedAt
  isAnsweredPlatinaQues Boolean    @default(false)
  isActive              Boolean    @default(true)
  isRiskLevelAdminSet   Boolean    @default(false)

  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  platinaRecommendations UserPlatinaRecommendation[]
}

model RiskLevelServiceRecommendation {
  id        String    @id @default(uuid())
  riskLevel RiskLevel @unique
  services  String[] // Array of service IDs or slugs
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// For Platina Wealth service with individual recommendations
model ServicePlatinaWealth {
  id                  String   @id
  minimumInvestment   Float?
  portfolioTypes      Json? // Different portfolio categories
  features            Json? // Unique features for this service
  riskBasedAllocation Json? // Risk-based asset allocation templates
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  service            Service                     @relation(fields: [id], references: [id], onDelete: Cascade)
  userRecommendation UserPlatinaRecommendation[]
}

// Individual recommendations for each user based on risk profile
model UserPlatinaRecommendation {
  id                     String   @id @default(uuid())
  userId                 String
  platinaServiceId       String
  riskProfileId          String?
  portfolioType          String?
  assetAllocation        Json?
  userInvestmentAmount   Float?
  nextRecommendationDate DateTime @default(now())
  isActive               Boolean  @default(true)
  rationale              Json?
  peChart                Json?
  epsChart               Json?

  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  stocks       UserPlatinaStockList[]
  stockHistory UserPlatinaStockHistory[]

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  platinaService ServicePlatinaWealth @relation(fields: [platinaServiceId], references: [id], onDelete: Cascade)
  riskProfile    UserRiskProfile?     @relation(fields: [riskProfileId], references: [id], onDelete: SetNull)

  @@unique([userId, platinaServiceId])
  @@index([userId])
}

enum StockChangeType {
  ADDED
  UPDATED
  REMOVED
  INITIAL
}

// New model for individual stock tracking
model UserPlatinaStockList {
  id                String  @id @default(uuid())
  recommendationId  String
  stockName         String
  stockTicker       String
  sector            String
  portfolioWeight   Float
  totalShares       Int
  currentSharePrice Float
  purchaseAmount    Float
  marketValue       Float
  PEratio           Float
  marketCapInCrore  Float
  entryDate         String
  exitDate          String?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  recommendation UserPlatinaRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@index([stockTicker])
  @@index([isActive])
}

model UserPlatinaStockHistory {
  id               String          @id @default(uuid())
  recommendationId String
  stockTicker      String
  stockName        String
  changeType       StockChangeType
  changeDate       DateTime        @default(now())

  previousWeight Float?
  newWeight      Float?

  changeDescription String

  // Additional metadata
  metadata Json?

  recommendation UserPlatinaRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@index([changeDate])
  @@index([stockTicker])
  @@index([changeType])
}

model Blog {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  excerpt       String? // Short summary
  content       Json
  featuredImage String?
  authorId      String?
  author        User?      @relation(fields: [authorId], references: [id])
  category      String[]
  status        BlogStatus @default(DRAFT)
  featured      Boolean    @default(false)
  published     Boolean    @default(false)
  views         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

//Banner

model Banner {
  id          String    @id @default(uuid())
  title       String
  text        String
  imageUrl    String?
  buttonLabel String
  buttonUrl   String
  bgColor     String?
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
