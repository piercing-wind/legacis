generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  INDIVIDUAL
  BUSINESS
}

enum UserRole {
  USER
  ADMIN
}

enum Status {
  CLOSED_CALL
  ACTIVE_CALL
}

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  RESUBMISSION_REQUIRED
  COMPLETED
  CANCELLED
}

enum ServiceType {
  COMBO
  TRADING
  RESEARCH_ADVISORY
  RESEARCH_ADVISORY_MODEL_PORTFOLIO
  RESEARCH_ADVISORY_PORTFOLIO_REVIEW
  INVESTMENT_ADVISORY
  RESEARCH_ADVISORY_MUTUAL_FUNDS
  SMALLCASE
  PLATINA_WEALTH
}

enum VerificationType {
  EMAIL_UPDATE
  PHONE_UPDATE
  EMAIL_VERIFY
  PHONE_VERIFY
  RESET_PASS_VERIFY
  CONSENT
  AGREEMENT_ACCEPTANCE
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  phone         String?   @unique
  username      String?   @unique
  image         String?
  password      String?
  dob           String?
  pan           String?   @unique
  aadharNumber  String?
  gstin         String?
  address       String?
  state         String?
  city          String?
  zip           String?
  panVerified   DateTime?
  termsAccepted DateTime?
  emailVerified DateTime?
  phoneVerified DateTime?
  isBanned      Boolean   @default(false)

  userType               UserType                    @default(INDIVIDUAL)
  role                   UserRole                    @default(USER)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  accounts               Account[]
  documents              UserDocuments[]
  purchasedServices      UserPurchasedServices[]
  panVerificationData    panVerificationData[]
  transaction            Transaction[]
  riskProfile            UserRiskProfile?
  riskProfileResponses   UserRiskProfileResponse[]
  platinaRecommendations UserPlatinaRecommendation[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Otp {
  id               String           @id @default(uuid())
  userId           String
  identifier       String
  otp              String
  expires_at       DateTime
  verificationType VerificationType
  createdAt        DateTime         @default(now())

  @@unique([userId, identifier, verificationType])
  @@index([userId, identifier])
}

model panVerificationData {
  userId    String   @id
  provider  String
  result    Json
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GrantType {
  PURCHASED // User actually paid for it
  COMPLIMENTARY // Granted as part of another service purchase
  ADMIN_GRANTED // Manually granted by admin
}

model UserPurchasedServices {
  id                  String    @id @default(uuid())
  userId              String
  serviceId           String
  purchaseDate        DateTime  @default(now())
  expiryDate          DateTime
  planDays            Int
  planDiscount        Float
  agreementAcceptedAt DateTime?
  agreementData       Json?

  grantType       GrantType @default(PURCHASED)
  grantedBy       String? // Admin user ID if manually granted
  grantReason     String? // Reason for manual grant or promotion details
  parentServiceId String? // If complimentary, which service purchase triggered this
  transactionId   String? // Link to actual payment transaction
  isActive        Boolean   @default(true)

  grantMetadata Json? //For coupons 

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([userId, serviceId, expiryDate])
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  percentOff  Float
  expiryDate  DateTime
  minAmount   Float    @default(0)
  maxAmount   Float?
  serviceId   String?
  planDays    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service      Service?      @relation(fields: [serviceId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id              String   @id @default(uuid())
  orderId         String?  @unique
  paymentId       String?
  couponId        String?
  userId          String
  serviceId       String
  amount          Float
  tenure          Json?
  currency        String   @default("INR")
  status          String
  paymentGateway  String
  idempotencyKey  String?
  webhookResponse Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  extraData       Json?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  coupon  Coupon?  @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([orderId])
}

model UserDocuments {
  id                  String         @id @default(uuid())
  serviceId           String
  userId              String
  documentUrl         String
  reviewedDocumentUrl String?
  status              DocumentStatus @default(PENDING)
  reviewedBy          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Agreement {
  id              String   @id @default(uuid())
  name            String
  content         Json
  version         Int
  hash            String
  signatoryPerson String?
  companyName     String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  serviceAgreements ServiceAgreement[]
}

model ServiceAgreement {
  id          String @id @default(uuid())
  serviceId   String
  agreementId String

  service   Service   @relation(fields: [serviceId], references: [id])
  agreement Agreement @relation(fields: [agreementId], references: [id])
}

model ComplimentaryService {
  id                     String @id @default(uuid())
  serviceId              String // The main service being sold
  complimentaryServiceId String // The included complimentary service

  service              Service @relation("Complimentary", fields: [serviceId], references: [id], onDelete: Cascade)
  complimentaryService Service @relation("ComplimentaryIncluded", fields: [complimentaryServiceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, complimentaryServiceId])
  @@index([serviceId])
  @@index([complimentaryServiceId])
}

model Service {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  tag                  String?
  label                String?
  serviceClass         String?
  description          String?
  chart                Json?
  comparisonTitle      String?
  recommendedService   String[]
  price                Float
  taxPercent           Float?
  tenureDiscounts      Json?
  features             Json?
  faq                  Json?
  active               Boolean               @default(true)
  type                 ServiceType
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  serviceTrading       ServiceTrading?
  servicePlatinaWealth ServicePlatinaWealth?

  //serviceResearchAdvisory                ServiceResearchAdvisory?       
  //serviceResearchAdvisoryModelPortfolio  ServiceResearchAdvisoryModelPortfolio? 
  //serviceResearchAdvisoryPortfolioReview ServiceResearchAdvisoryPortfolioReview? 
  //investmentAdvisory                     InvestmentAdviosry?   
  //complimentaryServices                  ComplimentaryService[]    
  //ServiceResearchAdvisoryMutualFunds     ServiceResearchAdvisoryMutualFunds[]
  complimentaryService    ComplimentaryService[] @relation("Complimentary") //Use this when you want to find all complimentary services included with a main service.
  complimentaryIncludedIn ComplimentaryService[] @relation("ComplimentaryIncluded") //Use this when you want to find all main services where a service is included as complimentary.

  agreements        ServiceAgreement[]
  purchasedServices UserPurchasedServices[]
  userDocuments     UserDocuments[]
  Transaction       Transaction[]
  coupon            Coupon[]
}

model ServiceTrading {
  id              String   @id
  buy_stock_list  Json
  sell_stock_list Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  service Service @relation(fields: [id], references: [id], onDelete: Cascade)
}

