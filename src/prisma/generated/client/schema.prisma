enum QuestionType {
  MCQ
  SCALE
  YES_NO
  TEXT
}

enum QuestionCategory {
  NORMAL
  PLATINA_WEALTH
}

/// - For MCQ and YES_NO, `options` is an array of objects:
///   [{ "value": 1, "text": "Low risk", "weight": 1 }]
///   For YES_NO, example:
///   [{ "value": "yes", "text": "Yes", "weight": 5 }, { "value": "no", "text": "No", "score": 0 }]
/// - For SCALE, use `minScore` and `maxScore` for the range; `options` is usually null.
/// - For TEXT, `options` is null and `weight` is usually 0 or not used.

model RiskProfileQuestion {
  id        String           @id @default(uuid())
  question  String // The question text
  type      QuestionType
  options   Json?
  isActive  Boolean          @default(true)
  order     Int // Display order
  category  QuestionCategory @default(NORMAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  userResponses UserRiskProfileResponse[]
}

model UserRiskProfileResponse {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  answer     Json // Store the selected answer(s)
  score      Int // Score for this answer
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question RiskProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserRiskProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  totalScore            Int // Sum of all question scores
  riskLevel             String // "CONSERVATIVE", "MODERATE", "AGGRESSIVE", "VERY_AGGRESSIVE"
  riskPercentage        Float // Risk score as percentage
  completedAt           DateTime @default(now())
  lastUpdated           DateTime @updatedAt
  isAnsweredPlatinaQues Boolean  @default(false)
  isActive              Boolean  @default(true)

  // Additional calculated fields
  categories      Json? // Breakdown by category {"EXPERIENCE": 75, "TOLERANCE": 60}
  recommendations Json? // Risk-based recommendations

  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  platinaRecommendations UserPlatinaRecommendation[]
}

// For Platina Wealth service with individual recommendations
model ServicePlatinaWealth {
  id                  String   @id
  minimumInvestment   Float?
  portfolioTypes      Json? // Different portfolio categories
  features            Json? // Unique features for this service
  riskBasedAllocation Json? // Risk-based asset allocation templates
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  service            Service                     @relation(fields: [id], references: [id], onDelete: Cascade)
  userRecommendation UserPlatinaRecommendation[]
}

// Individual recommendations for each user based on risk profile
model UserPlatinaRecommendation {
  id                   String   @id @default(uuid())
  userId               String
  platinaServiceId     String
  riskProfileId        String?
  portfolioType        String?
  assetAllocation      Json?
  userInvestmentAmount Float?
  recommendationDate   DateTime @default(now())
  isActive             Boolean  @default(true)
  rationale            Json?
  peChart              Json?
  epsChart             Json?

  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  stocks       UserPlatinaStockList[]
  stockHistory UserPlatinaStockHistory[]

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  platinaService ServicePlatinaWealth @relation(fields: [platinaServiceId], references: [id], onDelete: Cascade)
  riskProfile    UserRiskProfile?     @relation(fields: [riskProfileId], references: [id], onDelete: SetNull)

  @@unique([userId, platinaServiceId])
  @@index([userId])
}

enum StockChangeType {
  ADDED
  UPDATED
  REMOVED
  INITIAL
}

// New model for individual stock tracking
model UserPlatinaStockList {
  id                String  @id @default(uuid())
  recommendationId  String
  stockName         String
  stockTicker       String
  sector            String
  portfolioWeight   Float
  totalShares       Int
  currentSharePrice Float
  purchaseAmount    Float
  marketValue       Float
  PEratio           Float
  marketCapInCrore  Float
  entryDate         String
  exitDate          String?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  recommendation UserPlatinaRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@index([stockTicker])
  @@index([isActive])
}

model UserPlatinaStockHistory {
  id               String          @id @default(uuid())
  recommendationId String
  stockTicker      String
  stockName        String
  changeType       StockChangeType
  changeDate       DateTime        @default(now())

  previousWeight Float?
  newWeight      Float?

  changeDescription String

  // Additional metadata
  metadata Json?

  recommendation UserPlatinaRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@index([changeDate])
  @@index([stockTicker])
  @@index([changeType])
}
